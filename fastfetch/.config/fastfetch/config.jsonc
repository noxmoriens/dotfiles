// ~/.config/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " \u001b[90m ",
        "color": {
            "title": "magenta"
        }
    },
    "logo": {
        "type": "small",
        // "source": "~/.config/fastfetch/logo.txt",
        "height": 6,
        "padding": {
            "top": 3,
            "left": 6,
            "right": 12
        }
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": "  ",
            "format": "{3}",
            "keyColor": "140"
        },
        {
            "type": "kernel",
            "key": " 󰍛 ",
            "keyColor": "183"
        },
        {
            "type": "wm",
            "key": " 󰭠 ",
            "keyColor": "74"
        },
        {
            "type": "shell",
            "key": "  ",
            "keyColor": "117"
        },
        {
            "type": "terminal",
            "key": "  ",
            "keyColor": "174"
        },
        {
            "type": "uptime",
            "key": " 󰔚 ",
            "keyColor": "180"
        },
        {
            "type": "memory",
            "key": "  ",
            "keyColor": "168"
        },
        {
            "type": "packages",
            "key": " 󰏗 ",
            "keyColor": "110"
        },
        "break",
        {
            "type": "custom",
            "format": "     \u001b[90m󰊠  \u001b[31m󰊠  \u001b[32m󰊠  \u001b[33m󰊠  \u001b[34m󰊠  \u001b[35m󰊠  \u001b[36m󰊠  \u001b[37m󰊠 "
        }
    ]
}
