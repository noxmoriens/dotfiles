client.placeholder      #232136 #232136 #6e6a86 #232136 #232136
client.background       #232136


font pango:Iosevka Nerd Font 10

# ====================================
# Styles for SwayFX
#
# Disable these options if you use
# original sway
# ====================================
# Radiuscorner_radius
corner_radius 12

# Blur
blur enable
blur_xray disable
blur_radius 5
blur_passes 7
blur_brightness 0.88
blur_contrast 1.060
blur_noise 0.0186
blur_saturation 1.15

# Shadow
shadows enable
shadows_on_csd enable
shadow_offset 2 6
shadow_color #00000080
shadow_blur_radius 36
shadow_inactive_color #0a0a0c60

# Dim unfocused windows
default_dim_inactive 0.30
dim_inactive_colors.unfocused #1a1826FF
dim_inactive_colors.urgent #8b3a48FF

# LayerShell effects
layer_effects "gtk-layer-shell" {
    blur enable;
    shadows enable;
    corner_radius 12;
}
layer_effects "swaync" {
    blur enable;
    blur_ignore_transparent enable;
    shadows enable;
    corner_radius 12;
}

# titlebar_separator disable
# scratchpad_minimize disable

# ====================================
# Windows Rules
# ====================================

# global opacity
for_window [app_id=".*"] opacity 0.75;

# overwrite gnome applications
# for_window [app_id="org.gnome.*"] opacity 0.9;
for_window [app_id="wofi"] floating enable; move position center; border pixel 2; opacity 0.98; radius 8;
# for_window [app_id="com.obsproject.Studio"] opacity 1.0;
# for_window [app_id="app.zen_browser.zen"] opacity 1.0
for_window [app_id="foot"] opacity 0.85
for_window [app_id="kitty"] opacity 0.85
for_window [app_id="firefox"] opacity 0.95
for_window [app_id="dev.zed.Zed"] opacity 0.85
for_window [app_id="code-oss"] opacity 0.85
for_window [app_id="code"] opacity 0.85
for_window [class="discord"] opacity 0.85
for_window [app_id="com.mitchellh.ghostty"] opacity 0.95
# for_window [app_id="virt-manager"] opacity 1.0

# Floating
for_window [app_id="java"] floating enable, move position center;
for_window [app_id="nm-connection-editor"] floating enable; move position center;
for_window [app_id="firefox" title="Picture-in-Picture"] floating enable, move position center;
for_window [app_id="app.zen_browser.zen" title="Picture-in-Picture"] floating enable, move position center;



